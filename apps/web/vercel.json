{
  "framework": "nextjs",
  "buildCommand": "cd ../.. && pnpm install --frozen-lockfile && pnpm turbo run build --filter=@educational/web",
  "outputDirectory": ".next",
  "installCommand": "npm install -g pnpm@9.0.0",
  "env": {
    "NEXT_PUBLIC_API_URL": "@next_public_api_url",
    "NEXT_PUBLIC_SOCKET_URL": "@next_public_socket_url",
    "NEXT_PUBLIC_LOGIN_IDENTIFIER": "@next_public_login_identifier",
    "NEXT_PUBLIC_VIDEO_PROVIDER": "@next_public_video_provider",
    "NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT": "@next_public_imagekit_url_endpoint",
    "NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY": "@next_public_imagekit_public_key",
    "NEXT_PUBLIC_RAZORPAY_KEY_ID": "@next_public_razorpay_key_id",
    "NEXT_PUBLIC_FIREBASE_API_KEY": "@next_public_firebase_api_key",
    "NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN": "@next_public_firebase_auth_domain",
    "NEXT_PUBLIC_FIREBASE_PROJECT_ID": "@next_public_firebase_project_id",
    "NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID": "@next_public_firebase_messaging_sender_id",
    "NEXT_PUBLIC_FIREBASE_APP_ID": "@next_public_firebase_app_id",
    "NEXT_PUBLIC_FIREBASE_VAPID_KEY": "@next_public_firebase_vapid_key"
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
